      <aliases enabled='yes' />
      <column aggregation='None' datatype='integer' name='[Benefit per order (bin)]' role='dimension' type='quantitative'>
        <calculation class='bin' decimals='1' formula='[Benefit per order]' peg='0' size='79' />
      </column>
      <column datatype='real' name='[Benefit per order]' role='measure' type='quantitative' />
      <column caption='Total order' datatype='integer' name='[Calculation_0954971542380545]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order Id])' />
      </column>
      <column caption='Total Revenue' datatype='real' name='[Calculation_0954971542872066]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='Total quantity' datatype='real' name='[Calculation_0954971543015427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Order Item Quantity])' />
      </column>
      <column caption='Average Shipping Days' datatype='real' name='[Calculation_0954971543203844]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Days for shipping (real)])' />
      </column>
      <column caption='Average Scheduled Shipping Days' datatype='real' name='[Calculation_0954971543412741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Days for shipment (scheduled)])' />
      </column>
      <column caption='Late orders' datatype='integer' name='[Calculation_0954971543908358]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Delivery Status] = &quot;Late delivery&quot;&#13;&#10;THEN [Order Id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='On time Orders' datatype='integer' name='[Calculation_0954971544211463]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;IF [Delivery Status] = &quot;Shipping on time&quot;&#13;&#10;THEN [Order Id]&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Shipping Delay' datatype='integer' name='[Calculation_0954971549786121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Days for shipping (real)] - [Days for shipment (scheduled)]' />
      </column>
      <column caption='Delivery Performance' datatype='string' name='[Calculation_0954971550154762]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0954971549786121] &gt; 0 THEN &quot;Delayed&quot;&#13;&#10;ELSEIF [Calculation_0954971549786121] = 0 THEN &quot;On Schedule&quot;&#13;&#10;ELSE &quot;Early&quot;&#13;&#10;END' />
      </column>
      <column datatype='integer' name='[Category Id]' role='dimension' type='ordinal' />
      <column datatype='string' name='[Customer City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Customer Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='integer' name='[Customer Id]' role='dimension' type='ordinal' />
